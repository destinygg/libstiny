{
  "name": "@destinygg/libstiny",
  "description": "A framework-agnostic scss component library for use in the destiny.gg website",
  "version": "1.10.0",
  "type": "module",
  "main": "lib/index.scss",
  "sass": "lib/index.scss",
  "style": "dist/libstiny.css",
  "files": [
    "lib",
    "dist"
  ],
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/destinygg/libstiny.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "sass lib/index.scss dist/libstiny.css",
    "prepack": "npm run build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build --docs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.5",
    "@chromatic-com/storybook": "^1.3.3",
    "@storybook/addon-essentials": "^8.1.0-alpha.7",
    "@storybook/addon-interactions": "^8.1.0-alpha.7",
    "@storybook/addon-links": "^8.1.0-alpha.7",
    "@storybook/blocks": "^8.1.0-alpha.7",
    "@storybook/html": "^8.1.0-alpha.7",
    "@storybook/html-vite": "^8.1.0-alpha.7",
    "@storybook/manager-api": "^8.1.0-alpha.7",
    "@storybook/react-vite": "^8.0.10",
    "@storybook/test": "^8.1.0-alpha.7",
    "@storybook/theming": "^8.1.0-alpha.7",
    "cva": "^1.0.0-beta.1",
    "prettier": "^3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.76.0",
    "storybook": "^8.1.0-alpha.7",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
